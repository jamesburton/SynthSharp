<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SynthSharp.Core\SynthSharp.Core.csproj" />
    <ProjectReference Include="..\SynthSharp.Audio\SynthSharp.Audio.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>synthsharp</ToolCommandName>
    <PackageId>SynthSharp.Tool</PackageId>
    <Description>SynthSharp command-line companion for tone generation and preset bootstrap workflows.</Description>
    <Authors>SynthSharp</Authors>
    <PackageTags>synth;audio;tool;dnx</PackageTags>
  </PropertyGroup>

</Project>
