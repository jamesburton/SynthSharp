<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SynthSharp.App.MainPage"
             Title="SynthSharp MVP">
    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="12">
            <Label Text="SynthSharp MVP"
                   Style="{StaticResource Headline}" />
            <Label Text="4-row keyboard layout (number row included), fully reconfigurable."
                   Style="{StaticResource SubHeadline}" />

            <Border StrokeThickness="1" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Pad editor" FontAttributes="Bold" />
                    <Picker x:Name="PadPicker"
                            Title="Select pad"
                            SelectedIndexChanged="OnPadSelectionChanged" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                        <Label Grid.Row="0" Text="Label" VerticalTextAlignment="Center" />
                        <Entry Grid.Row="0" Grid.Column="1" x:Name="LabelEntry" Placeholder="Kick / Lead A1 / etc." />
                        <Label Grid.Row="1" Text="Key" VerticalTextAlignment="Center" />
                        <Entry Grid.Row="1" Grid.Column="1" x:Name="KeyBindingEntry" Placeholder="A, 1, Space, ..." />
                        <Label Grid.Row="2" Text="Pitch" VerticalTextAlignment="Center" />
                        <Entry Grid.Row="2" Grid.Column="1" x:Name="PitchEntry" Placeholder="C4 or 440" />
                        <Label Grid.Row="3" Text="Wave" VerticalTextAlignment="Center" />
                        <Picker Grid.Row="3" Grid.Column="1" x:Name="WaveformPicker" />
                        <Label Grid.Row="4" Text="Attack (s)" VerticalTextAlignment="Center" />
                        <Entry Grid.Row="4" Grid.Column="1" x:Name="AttackEntry" Placeholder="0.01" />
                        <Label Grid.Row="5" Text="Decay (s)" VerticalTextAlignment="Center" />
                        <Entry Grid.Row="5" Grid.Column="1" x:Name="DecayEntry" Placeholder="0.05" />
                        <Label Grid.Row="6" Text="Sustain (0-1)" VerticalTextAlignment="Center" />
                        <Entry Grid.Row="6" Grid.Column="1" x:Name="SustainEntry" Placeholder="0.80" />
                        <Label Grid.Row="7" Text="Release (s)" VerticalTextAlignment="Center" />
                        <Entry Grid.Row="7" Grid.Column="1" x:Name="ReleaseEntry" Placeholder="0.10" />
                        <Label Grid.Row="8" Text="Sample" VerticalTextAlignment="Center" />
                        <Label Grid.Row="8" Grid.Column="1" x:Name="SampleFileLabel" Text="(none)" VerticalTextAlignment="Center" />
                        <Label Grid.Row="9" Text="Gain (0-2)" VerticalTextAlignment="Center" />
                        <Entry Grid.Row="9" Grid.Column="1" x:Name="GainEntry" Placeholder="1.0" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                        <Label Grid.Row="0" Text="Filter type" VerticalTextAlignment="Center" />
                        <Picker Grid.Row="0" Grid.Column="1" x:Name="FilterTypePicker" />
                        <Label Grid.Row="1" Text="Filter cutoff (Hz)" VerticalTextAlignment="Center" />
                        <Entry Grid.Row="1" Grid.Column="1" x:Name="FilterCutoffEntry" Placeholder="1000" />
                        <Label Grid.Row="2" Text="Filter Q" VerticalTextAlignment="Center" />
                        <Entry Grid.Row="2" Grid.Column="1" x:Name="FilterResonanceEntry" Placeholder="0.707" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                        <Label Grid.Row="0" Text="LFO target" VerticalTextAlignment="Center" />
                        <Picker Grid.Row="0" Grid.Column="1" x:Name="LfoTargetPicker" />
                        <Label Grid.Row="1" Text="LFO rate (Hz)" VerticalTextAlignment="Center" />
                        <Entry Grid.Row="1" Grid.Column="1" x:Name="LfoRateEntry" Placeholder="4.0" />
                        <Label Grid.Row="2" Text="LFO depth (0-1)" VerticalTextAlignment="Center" />
                        <Entry Grid.Row="2" Grid.Column="1" x:Name="LfoDepthEntry" Placeholder="0.5" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                        <Label Grid.Row="0" Text="Loop sample" VerticalTextAlignment="Center" />
                        <CheckBox Grid.Row="0" Grid.Column="1" x:Name="LoopEnabledCheckBox" />
                        <Label Grid.Row="1" Text="Loop start (frames)" VerticalTextAlignment="Center" />
                        <Entry Grid.Row="1" Grid.Column="1" x:Name="LoopStartEntry" Placeholder="0" />
                        <Label Grid.Row="2" Text="Loop end (frames; 0 = end)" VerticalTextAlignment="Center" />
                        <Entry Grid.Row="2" Grid.Column="1" x:Name="LoopEndEntry" Placeholder="0" />
                    </Grid>

                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Apply to pad" Clicked="OnApplyPadClicked" />
                        <Button Text="Play selected" Clicked="OnPlaySelectedClicked" />
                        <Button Text="Load sample..." Clicked="OnLoadSampleClicked" />
                        <Button Text="Clear sample" Clicked="OnClearSampleClicked" />
                        <Button Text="Save preset" Clicked="OnSavePresetClicked" />
                        <Button Text="Load preset" Clicked="OnLoadPresetClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label x:Name="StatusLabel" TextColor="{AppThemeBinding Light=Black, Dark=White}" />

            <Border StrokeThickness="1" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Pattern" FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="Track:" VerticalTextAlignment="Center" />
                        <Picker x:Name="TrackPicker" WidthRequest="180" SelectedIndexChanged="OnTrackSelectionChanged" />
                        <Button Text="+ Add" Clicked="OnAddTrackClicked" />
                        <Button Text="× Remove" Clicked="OnRemoveTrackClicked" />
                    </HorizontalStackLayout>
                    <Label x:Name="PatternStatusLabel" Text="0 events, length 0 ms" />
                    <HorizontalStackLayout Spacing="8">
                        <Button x:Name="RecordButton" Text="Record" Clicked="OnRecordClicked" />
                        <Button x:Name="PlayPatternButton" Text="Play set" Clicked="OnPlayPatternClicked" />
                        <Button x:Name="StopPatternButton" Text="Stop" Clicked="OnStopPatternClicked" />
                        <Button Text="Clear track" Clicked="OnClearPatternClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="1" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="MIDI input" FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="Device:" VerticalTextAlignment="Center" />
                        <Picker x:Name="MidiDevicePicker" WidthRequest="220" />
                        <Button Text="Refresh" Clicked="OnRefreshMidiDevicesClicked" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="8">
                        <Button x:Name="MidiConnectButton" Text="Connect" Clicked="OnConnectMidiClicked" />
                        <Button Text="Disconnect" Clicked="OnDisconnectMidiClicked" />
                    </HorizontalStackLayout>
                    <Label x:Name="MidiStatusLabel" Text="Not connected." />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout x:Name="PadRowsLayout" Spacing="8" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
